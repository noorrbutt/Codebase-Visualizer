GROQ_API_KEY=
# Public demo endpoints rely on server-side rate limiting; no browser API key is required.
DATABASE_URL=sqlite:///./codebase_visualizer.db
# GITHUB_TOKEN is optional but recommended to avoid GitHub rate limits.
# Unauthenticated requests are limited to 60 requests/hr; authenticated requests can use 5000/hr.
GITHUB_TOKEN=
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of trusted frontend origins. Keep this explicit; do not use *.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
