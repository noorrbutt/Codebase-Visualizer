GROQ_API_KEY=
# Server-side only: keep this out of browser code and public routes.
API_KEY=
# Database connection string for the backend; a bad value prevents startup or points the app at the wrong data store.
DATABASE_URL=sqlite:///./codebase_visualizer.db
# GitHub token is optional but recommended to avoid GitHub rate limits.
# Unauthenticated requests are limited to 60 requests/hr; authenticated requests can use 5000/hr.
GITHUB_TOKEN=
# Redis connection string for shared rate-limit and repo-lock state; a bad URL breaks coordination across workers.
REDIS_URL=redis://localhost:6379/0
# Runtime environment name; changing it can alter feature flags and other behavior-sensitive settings.
APP_ENV=development
# Logging verbosity for the backend; too little logging can make incidents hard to diagnose.
LOG_LEVEL=INFO
# Comma-separated list of trusted frontend origins. Keep this explicit; do not use *.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Per-minute per-IP rate limit for public endpoints; raising it too high weakens abuse protection, lowering it too much blocks legitimate traffic.
RATE_LIMIT_REQUESTS_PER_MINUTE=20
# Maximum number of files to ingest from a repository during analysis; too low truncates large repos, too high increases memory and CPU usage.
MAX_REPO_FILES=300
# Global cap on concurrently running repository analyses to limit memory and bandwidth spikes.
MAX_CONCURRENT_REPO_ANALYSES=5
# Only set true if the app is deployed behind a proxy that strips or overwrites client-supplied X-Forwarded-For headers before they reach this app; otherwise rate limiting can be bypassed by spoofing the header.
TRUST_PROXY_HEADERS=False
# Number of seconds after which a repo lock is considered stale and may be reclaimed; too low can cause overlapping analyses, too high can block recovery after a crash.
RECLAIM_LOCK_AFTER_SECONDS=600
# Hourly cap on AI-assisted requests; too low throttles features unexpectedly, too high can exhaust quota or budget.
AI_MAX_REQUESTS_PER_HOUR=60
# Daily cap on AI-assisted requests; too low throttles features unexpectedly, too high can exhaust quota or budget.
AI_MAX_REQUESTS_PER_DAY=200
# Per-client hourly burst ceiling for AI requests; this keeps one IP or API key from burning the whole deployment budget in one burst.
AI_MAX_CLIENT_REQUESTS_PER_HOUR=10
# Per-client daily ceiling for AI requests; keep this well below the global daily budget so a single client cannot exhaust the shared allocation.
AI_MAX_CLIENT_REQUESTS_PER_DAY=40
