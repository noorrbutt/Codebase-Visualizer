VITE_API_URL=http://127.0.0.1:8000
VITE_API_KEY=
# Sent as X-API-Key header. Visible in browser bundle - this only deters casual abuse, not a determined user. Real protection is server-side IP rate limiting.
# No client-side secret is required for public GET endpoints; only POST /repos/analyze uses the API key when configured on the backend.
