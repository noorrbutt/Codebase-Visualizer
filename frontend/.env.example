VITE_API_URL=http://127.0.0.1:8000
VITE_API_KEY=
# Sent as X-API-Key header. Not a real secret once shipped to the browser - deters casual abuse only.
# Real protection = server-side IP rate limiting + optional infra-level (WAF/CDN) rate limit on /repos/analyze.
# No client-side secret is required for public GET endpoints; only POST /repos/analyze uses the API key when configured on the backend.
